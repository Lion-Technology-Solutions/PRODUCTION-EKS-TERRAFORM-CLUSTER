pipeline {
  agent any

  options {
    ansiColor('xterm')
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  parameters {
    string(name: 'AWS_REGION', defaultValue: 'us-east-1', description: 'AWS region for the liontech EKS cluster')
    string(name: 'AWS_CREDENTIALS_ID', defaultValue: 'aws-jenkins-terraform', description: 'Jenkins AWS credentials ID')
    string(name: 'TF_STATE_BUCKET', defaultValue: 'liontech-production-terraform-state', description: 'S3 bucket for Terraform state')
    string(name: 'TF_STATE_KEY', defaultValue: 'production/eks/liontech.tfstate', description: 'S3 key for Terraform state')
    string(name: 'TF_STATE_DYNAMODB_TABLE', defaultValue: 'liontech-production-terraform-locks', description: 'DynamoDB lock table')
    string(name: 'TFVARS_FILE', defaultValue: 'environments/prod/prod.tfvars', description: 'Terraform tfvars file in the repository')
    booleanParam(name: 'CONFIRM_DESTROY', defaultValue: false, description: 'Must be checked to destroy the liontech EKS cluster')
    booleanParam(name: 'FORCE_REMOVE_UNREACHABLE_HELM_STATE', defaultValue: false, description: 'Only use when the EKS cluster is already deleted or unreachable; removes Helm releases from Terraform state before destroy')
  }

  environment {
    TF_IN_AUTOMATION = 'true'
    TF_INPUT         = 'false'
    TF_VAR_aws_region = "${params.AWS_REGION}"
  }

  stages {
    stage('Safety Check') {
      steps {
        script {
          if (!params.CONFIRM_DESTROY) {
            error('CONFIRM_DESTROY must be checked before running terraform destroy.')
          }
        }
      }
    }

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Terraform Init') {
      steps {
        withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: params.AWS_CREDENTIALS_ID]]) {
          sh """
            terraform init \\
              -backend-config="bucket=${params.TF_STATE_BUCKET}" \\
              -backend-config="key=${params.TF_STATE_KEY}" \\
              -backend-config="region=${params.AWS_REGION}" \\
              -backend-config="dynamodb_table=${params.TF_STATE_DYNAMODB_TABLE}" \\
              -backend-config="encrypt=true"
          """
        }
      }
    }

    stage('Manual Approval') {
      steps {
        input message: 'Destroy the production liontech EKS cluster and all managed infrastructure?', ok: 'Destroy'
      }
    }

    stage('Remove Unreachable Helm State') {
      when {
        expression { return params.FORCE_REMOVE_UNREACHABLE_HELM_STATE }
      }
      steps {
        withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: params.AWS_CREDENTIALS_ID]]) {
          sh """
            HELM_STATE="\$(terraform state list | grep '^module.autoscaling.helm_release' || true)"
            if [ -n "\$HELM_STATE" ]; then
              echo "\$HELM_STATE" | while read -r address; do
                terraform state rm "\$address"
              done
            else
              echo "No Helm release resources found in Terraform state."
            fi
          """
        }
      }
    }

    stage('Destroy Kubernetes Add-ons First') {
      when {
        expression { return !params.FORCE_REMOVE_UNREACHABLE_HELM_STATE }
      }
      steps {
        withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: params.AWS_CREDENTIALS_ID]]) {
          sh """
            VAR_FILE_ARG=""
            if [ -f "${params.TFVARS_FILE}" ]; then
              VAR_FILE_ARG="-var-file=${params.TFVARS_FILE}"
            fi

            HELM_STATE="\$(terraform state list | grep '^module.autoscaling.helm_release' || true)"
            if [ -n "\$HELM_STATE" ]; then
              TARGET_ARGS=""
              for address in \$HELM_STATE; do
                TARGET_ARGS="\$TARGET_ARGS -target=\$address"
              done

              echo "Destroying Helm-managed Kubernetes add-ons before deleting EKS..."
              terraform destroy -auto-approve \$VAR_FILE_ARG \$TARGET_ARGS
            else
              echo "No Helm release resources found in Terraform state."
            fi
          """
        }
      }
    }

    stage('Terraform Destroy Plan') {
      steps {
        withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: params.AWS_CREDENTIALS_ID]]) {
          sh """
            if [ -f "${params.TFVARS_FILE}" ]; then
              terraform plan -destroy -var-file="${params.TFVARS_FILE}" -out=destroy.tfplan
            else
              terraform plan -destroy -out=destroy.tfplan
            fi
          """
        }
      }
    }

    stage('Terraform Destroy') {
      steps {
        withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: params.AWS_CREDENTIALS_ID]]) {
          sh 'terraform apply -auto-approve destroy.tfplan'
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'destroy.tfplan', allowEmptyArchive: true
    }
  }
}
